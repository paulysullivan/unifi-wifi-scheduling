# Application secrets
SECRET_KEY=
ENCRYPTION_KEY=

# Database
DB_PATH=../data/network_schedule.db

# Server
PORT=7323
CORS_ORIGINS=http://localhost:5173,http://localhost:7323

# First-run admin seeding (used only once if no users exist in DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Extension limits
MAX_EXTENSION_MINUTES=120

# Timezone for schedule enforcement (IANA name; used by Docker)
TZ=America/New_York
